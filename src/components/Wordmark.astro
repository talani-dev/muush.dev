---
/**
 * Wordmark — `muush.dev` (full) or `muush` (short).
 * Geometry and type from `docs/business/landing/design-extract.md` § 5.
 *
 * The three runs `muush` / `.` / `dev` are the one deliberately hardcoded
 * string set in this layer: they are brand identity, not copy, and they are
 * locale-invariant (`docs/business/messaging.md` rule 6, "muush siempre en
 * minúsculas"). Everything else in these primitives comes from the caller.
 *
 * The runs sit in a flex row with no gap so they read as one word; flex also
 * makes the markup immune to the whitespace a formatter may insert between
 * them.
 */

export type WordmarkForm = 'full' | 'short'

interface Props {
  form?: WordmarkForm
  class?: string
}

const { form = 'full', class: className } = Astro.props
---

<span
  class:list={[
    'inline-flex items-baseline text-wordmark font-poppins text-bone-100',
    className,
  ]}
>
  <span>muush</span>
  {form === 'full' && (
      <Fragment>
        <span class="text-red-400">.</span>
        <span>dev</span>
      </Fragment>
    )}
</span>
