---
/**
 * LinkArrow — the secondary call to action. Loose text with a trailing
 * arrow, from `docs/business/landing/design-extract.md` § 7.
 *
 * It must never paint a background or a border in any state: a box turns it
 * back into a button, and the hero is designed to contain exactly one box
 * (`docs/business/landing/ui-map.md` § 3, "nunca un fondo").
 *
 * The arrow is appended by the component, not by the caller, so the hover
 * affordance always has something to move and no caller has to remember it.
 */

export type LinkArrowSize = 'default' | 'large'

interface Props {
  href: string
  size?: LinkArrowSize
  external?: boolean
  class?: string
}

const {
  href,
  size = 'default',
  external = false,
  class: className,
} = Astro.props

const roleBySize = {
  default: 'text-link',
  large: 'text-link-lg',
} satisfies Record<LinkArrowSize, string>
---

<!-- biome-ignore lint/a11y/useAnchorContent: the text comes from the slot -->
<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'link-arrow font-instrument text-bone-100',
    roleBySize[size],
    className,
  ]}
>
  <slot />
  <span class="arrow" aria-hidden="true">→</span>
</a>

<style>
/*
   * No background and no border here, in any state — that rule is the whole
   * point of this component. The only hover affordance is the underline and
   * a small arrow shift, expressed in em so it tracks the type role.
   */
.link-arrow {
  --arrow-shift: 0.15em;
  text-decoration: none;
}

.link-arrow:hover {
  text-decoration: underline;
}

.arrow {
  display: inline-block;
  transition: transform 0.2s ease-out;
}

.link-arrow:hover .arrow {
  transform: translateX(var(--arrow-shift));
}

@media (prefers-reduced-motion: reduce) {
  .arrow {
    transition: none;
  }

  .link-arrow:hover .arrow {
    transform: none;
  }
}
</style>
